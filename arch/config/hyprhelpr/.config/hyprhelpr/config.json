{
  "screenshare": {
    "menuCommand": "rofi -dmenu -i",
    "debounceDuration": 10
  },
  "zoom": {
    "default": 0.5,
    "animate": false,
    "duration": 0.2,
    "fps": 120
  },
  "wallpaper": {
    "directory": "~/Wallpapers"
  },
  "screencast": {
    "recorderExec": "gpu-screen-recorder",
    "directory": "~/Videos/Screencasts/",
    "silent": false,
    "onSaveCommands": {
      "thunar": "nohup xargs kitty -e yazi &",
      "upload": "~/.scripts/uploadS3.sh"
    },
    "onInterfaceUpdateCommand": "pkill -RTMIN+2 waybar"
  },
  "indicator": {
    "onInterfaceUpdateCommand": "pkill -RTMIN+3 waybar",
    "entries": [
      {
        "name": "loading",
        "content": "",
        "animation": ["⣾", "⣽", "⣻", "⢿", "⡿", "⣟", "⣯", "⣷"],
        "frameDelay": 0.25
      }
    ]
  },
  "toggle": {
    "entries": [
      {
        "name": "weather",
        "command": "kitty --class=me.weather -e ~/.scripts/weather.sh 5",
        "size": "{1200, 800}",
        "processMatch": "class=me.weather"
      },
      {
        "name": "term-calc",
        "command": "kitty --class=me.term-calc -e kalc",
        "size": "{500, 400}"
      },
      {
        "name": "term-notes",
        "command": "kitty --class=me.term-notes --directory ~/Notes/Tanner/ -e ~/.scripts/nvim.sh",
        "size": "{\"monitor_w/1.3\", \"monitor_h/1.3\"}"
      },
      {
        "name": "sound-control",
        "command": "~/.scripts/audio.sh output",
        "size": "{680, 800}"
      },
      {
        "name": "music",
        "command": "flatpak run sh.cider.Cider",
        "size": "{1300, \"monitor_h/1.15\"}",
        "processMatch": "cider"
      },
      {
        "name": "deepseek",
        "command": "~/.local/share/launcherscripts/deepseek.sh \"{size = {\\\"monitor_w/1.8\\\", \\\"monitor_h/1.2\\\"}, float = true}\"",
        "raw": true,
        "processMatch": "[--]name deepseek-widget"
      },
      {
        "name": "claude",
        "command": "~/.local/share/launcherscripts/claude.sh \"{size = {\\\"monitor_w/1.8\\\", \\\"monitor_h/1.2\\\"}, float = true}\"",
        "raw": true,
        "processMatch": "[--]name claude-widget"
      },
      {
        "name": "gedit",
        "command": "flatpak run org.gnome.gedit --class=me.gedit-toggle",
        "processMatch": "^gedit --class=me.gedit-toggle",
        "size": "{60%, 80%}"
      }
    ]
  },
  "menu": {
    "command": "rofi -dmenu -i",
    "entries": [
      {
        "label": "Connect To Server",
        "command": "rofi -show ssh",
        "next": []
      },
      {
        "label": "Connect to Samba",
        "command": "",
        "next": [
          {
            "label": "Backup",
            "command": "~/.scripts/samba.sh backups"
          },
          {
            "label": "Archive",
            "command": "~/.scripts/samba.sh archive"
          },
          {
            "label": "Media",
            "command": "~/.scripts/samba.sh media"
          }
        ]
      },
      {
        "label": "Color Picker",
        "command": "",
        "next": [
          {
            "label": "Hex",
            "command": "sleep 0.2; hyprpicker --format hex | wl-copy"
          },
          {
            "label": "RGB",
            "command": "sleep 0.2; hyprpicker --format rgb | wl-copy"
          },
          {
            "label": "HSV",
            "command": "sleep 0.2; hyprpicker --format hsv | wl-copy"
          },
          {
            "label": "HSL",
            "command": "sleep 0.2; hyprpicker --format hsl | wl-copy"
          },
          {
            "label": "CMYK",
            "command": "sleep 0.2; hyprpicker --format cmyk | wl-copy"
          }
        ]
      },
      {
        "label": "Screencast",
        "command": "",
        "next": [
          {
            "label": "Manage",
            "command": "kitty --class=me.castui -e castui"
          },
          {
            "label": "Screen",
            "command": "sleep 0.2; hyprhelpr screencast start"
          },
          {
            "label": "Region",
            "command": "sleep 0.2; hyprhelpr screencast start region"
          }
        ]
      },
      {
        "label": "Upload File",
        "command": "kitty -e ~/.scripts/aws-uploader.sh"
      },
      {
        "label": "Airplay",
        "command": "",
        "next": [
          {
            "label": "Start",
            "command": "~/.scripts/airplay.sh start"
          },
          {
            "label": "Stop",
            "command": "~/.scripts/airplay.sh stop"
          }
        ]
      },
      {
        "label": "Music Visualizer",
        "command": "",
        "next": [
          {
            "label": "Fractal Zoom",
            "command": "~/.scripts/launch-cava-shader.sh fractal_zoom.frag"
          },
          {
            "label": "Fire",
            "command": "~/.scripts/launch-cava-shader.sh fire.frag"
          },
          {
            "label": "Plasma Constellation",
            "command": "~/.scripts/launch-cava-shader.sh plasma_constellation.frag"
          },
          {
            "label": "Aurora Bloom",
            "command": "~/.scripts/launch-cava-shader.sh aurora_bloom.frag"
          },
          {
            "label": "Bar Spectrum",
            "command": "~/.scripts/launch-cava-shader.sh bar_spectrum.frag"
          },
          {
            "label": "Eye of Phi",
            "command": "~/.scripts/launch-cava-shader.sh eye_of_phi.frag"
          },
          {
            "label": "Northern Lights",
            "command": "~/.scripts/launch-cava-shader.sh northern_lights.frag"
          },
          {
            "label": "Orion Circle",
            "command": "~/.scripts/launch-cava-shader.sh orion_circle.frag"
          },
          {
            "label": "Orion Circle Rotate",
            "command": "~/.scripts/launch-cava-shader.sh orion_circle_rotate.frag"
          },
          {
            "label": "Orion Saturn Core",
            "command": "~/.scripts/launch-cava-shader.sh orion_saturn_core.frag"
          },
          {
            "label": "Orion Saturn Subring",
            "command": "~/.scripts/launch-cava-shader.sh orion_saturn_subring.frag"
          },
          {
            "label": "Winamp Spectrum",
            "command": "~/.scripts/launch-cava-shader.sh winamp_spectrum.frag"
          },
          {
            "label": "Winamp Line Spectrum",
            "command": "~/.scripts/launch-cava-shader.sh winamp_line_style_spectrum.frag"
          }
        ]
      },
      {
        "label": "Emoji Picker",
        "command": "rofi -modi emoji -show emoji",
        "next": []
      },
      {
        "label": "Set Wallpaper",
        "command": "hyprhelpr wallpaper set \"$(hyprhelpr wallpaper list | rofi -dmenu -i)\"",
        "next": []
      },
      {
        "label": "Wifi",
        "command": "~/.scripts/wifi.sh"
      },
      {
        "label": "Bluetooth",
        "command": "~/.scripts/bluetooth.sh"
      },

      {
        "label": "Burn ISO",
        "command": "kitty -e ~/.scripts/burn-iso.sh"
      },
      {
        "label": "Update System",
        "command": "kitty -e bash -c '~/.scripts/update.sh; echo; read -n1 -srp \"Press any key to close...\"'"
      },
      {
        "label": "Launch Windows",
        "command": "hyprctl dispatch 'hl.dsp.exec_cmd(\"[workspace empty] ~/.scripts/windows.sh\")'"
      }
    ]
  }
}
